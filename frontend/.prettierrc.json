{
    "useTabs": true,
    "tabWidth": 4,
    "printWidth": 80,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all",
    "bracketSameLine": true,
    "arrowParens": "always",
    "endOfLine": "lf",
    "overrides": [
        {
            "files": ["*.json", "*.jsonc"],
            "options": { "useTabs": false }
        },
        {
            "files": ["*.html"],
            "options": { "useTabs": false }
        }
    ]
}
